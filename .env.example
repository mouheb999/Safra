# Supabase — Project Settings → API Keys. Leave empty to run on the local data in src/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Phase 3: storing requests via submit_request). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public site address for canonical URLs, sitemap and social cards (defaults to https://safra.website).
# Set it on preview/staging deployments.
NEXT_PUBLIC_SITE_URL=

# Live prices of the day for "Find my trip" (Google Flights + Google Hotels via serpapi.com). Server-only.
# Leave empty to use the trip brain's estimates. Searches are capped per month in /admin/brain.
SERPAPI_API_KEY=
