// Generates supabase/seed.sql from src/data so the database and the local fallback never drift.
// Run: npm run db:seed:generate

import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { localDestinations as destinations } from "../src/data/destinations.ts";
import { localSafaris as safaris } from "../src/data/safaris.ts";
import { localPacks } from "../src/data/packs.ts";
import { localVisaServices } from "../src/data/visas.ts";

const q = (value: string) => `'${value.replaceAll("'", "''")}'`;
const textArray = (values: string[]) => `array[${values.map(q).join(", ")}]::text[]`;
const json = (value: unknown) => `${q(JSON.stringify(value ?? {}))}::jsonb`;
const intArray = (values: number[]) => `array[${values.join(", ")}]::smallint[]`;

const destinationRows = destinations.map(
  (d, i) => `  (${[
    q(d.slug),
    q(d.country),
    q(d.title),
    q(d.description),
    textArray(d.highlights),
    d.match,
    q(d.duration),
    d.estimatedTotal,
    d.minBudget,
    d.maxBudget,
    q(d.heroImage.src),
    q(d.heroImage.alt),
    q(d.cardImage.src),
    q(d.cardImage.alt),
    d.teaser.budget,
    q(d.teaser.duration),
    textArray(d.teaser.tags),
    textArray(d.quiz.tags),
    textArray(d.quiz.durationBands),
    intArray(d.quiz.monthAffinity),
    `${q(JSON.stringify(d.quiz.travelerSuitability))}::jsonb`,
    i,
    json(d.translations),
  ].join(", ")})`,
);

const safariRows = safaris.map(
  (s, i) =>
    `  (${[q(s.slug), q(s.name), q(s.description), q(s.duration), textArray(s.highlights), q(s.image.src), q(s.image.alt), i, json(s.translations)].join(", ")})`,
);

const serviceRows = localVisaServices.map(
  (v, i) =>
    `  (${[q(v.slug), q(v.name), q(v.country), q(v.flag), v.priceDT, q(v.description), textArray(v.includes), textArray(v.documents), i, json(v.translations)].join(", ")})`,
);

const packRows = localPacks.map(
  (p, i) =>
    `  (${[q(p.slug), q(p.title), q(p.country), q(p.route), q(p.blurb), p.priceDT, p.nights, q(p.image), textArray(p.includes), textArray(p.vibes), p.destinationSlug ? q(p.destinationSlug) : "null", json(p.translations), i].join(", ")})`,
);

const sql = `-- Generated by scripts/generate-seed.mts from src/data — do not edit by hand.

insert into public.destinations (
  slug, country, title, description, highlights, match_default, duration, estimated_total,
  min_budget, max_budget, hero_image_url, hero_image_alt, card_image_url, card_image_alt,
  teaser_budget, teaser_duration, teaser_tags, quiz_tags, duration_bands, month_affinity,
  traveler_suitability, sort_order, translations
) values
${destinationRows.join(",\n")}
on conflict (slug) do nothing;

insert into public.safaris (slug, name, description, duration, highlights, image_url, image_alt, sort_order, translations) values
${safariRows.join(",\n")}
on conflict (slug) do nothing;

insert into public.services (slug, name, country, flag, price_dt, description, includes, documents, sort_order, translations) values
${serviceRows.join(",\n")}
on conflict (slug) do nothing;

insert into public.packs (slug, title, country, route, blurb, price_dt, nights, image_url, includes, vibes, destination_slug, translations, sort_order) values
${packRows.join(",\n")}
on conflict (slug) do nothing;
`;

const out = fileURLToPath(new URL("../supabase/seed.sql", import.meta.url));
writeFileSync(out, sql);
console.log(`Wrote ${out} (${destinations.length} destinations, ${safaris.length} safaris, ${localVisaServices.length} visa services, ${localPacks.length} packs)`);
